# ## version 2
[Unit]
Description=FBReelz - Refresh saved items and download cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fbreelz
Environment=TZ=Europe/London
ExecStart=/bin/bash -lc 'source /opt/fbreelz/.venv/bin/activate && python /opt/fbreelz/fbreelz_phase1_playwright.py --max 30 && python /opt/fbreelz/fbreelz_phase2_resolve.py --download --http-base http://YOUR_SERVER_IP'
