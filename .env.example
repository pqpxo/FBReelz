# FBReelz settings. Copy to .env next to docker-compose.yml.
# docker compose reads .env automatically.

# Timezone for timestamps in the container
TZ=Europe/London

# Base URL other devices use to reach NGINX. When set, phase 2 also writes
# fbreelz_cache_http.m3u with full links, e.g. http://192.168.1.50/cache/<file>.mp4
FBREELZ_HTTP_BASE=http://YOUR_SERVER_IP

# Optional browser user agent for Playwright and yt-dlp (blank = built-in default)
FBREELZ_UA=
