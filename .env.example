# Copy to .env next to docker-compose.yml. Docker Compose reads it automatically.

# Required: password for the admin controls (Phase 1/2, Cleanup, Purge, Cookie Manager).
# Admin is disabled until this is set.
ADMIN_PASSWORD=

# Host port for the web player
FBREELZ_PORT=3001

# Days a video stays after you mark it watched, before Cleanup deletes it
RETENTION_DAYS=3

# Optional: Pushover notification when Phase 2 finishes (leave blank to turn off)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

TZ=Europe/London
